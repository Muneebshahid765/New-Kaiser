<tr>
  <td class="em-head" style="padding:22px 32px;border-bottom:1px solid #E8DFD4;background:#FFFFFF;">
    <table cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td style="vertical-align:middle;padding-right:12px;">
          <img src="{{brandLogo}}" alt="{{brandName}}" width="36" height="36"
               style="width:36px;height:36px;border-radius:8px;border:1px solid #E8DFD4;display:block;">
        </td>
        <td style="vertical-align:middle;">
          <span style="font-size:15px;font-weight:700;color:#3B2516;font-family:'Segoe UI',Roboto,Arial,sans-serif;">{{brandName}}</span>
        </td>
      </tr>
    </table>
  </td>
</tr>
