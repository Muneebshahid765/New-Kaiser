<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Reset Your Password</title>
  <style>
    @media only screen and (max-width:600px){
      .em-wrap  { padding:12px !important; }
      .em-box   { border-radius:8px !important; }
      .em-head  { padding:18px 20px !important; }
      .em-body  { padding:24px 20px !important; }
      .em-foot  { padding:14px 20px !important; }
      .em-btn   { display:block !important; text-align:center !important; width:auto !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#F5EFE6;">
<table class="em-wrap" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color:#F5EFE6;padding:24px 16px;">
  <tr>
    <td align="center">
      <table class="em-box" width="560" cellpadding="0" cellspacing="0" border="0"
             style="max-width:560px;width:100%;background:#FFFFFF;border-radius:12px;border:1px solid #E8DFD4;overflow:hidden;">

        {{> header}}

        <tr>
          <td class="em-body" style="padding:32px;">
            <p style="margin:0 0 4px;font-size:20px;font-weight:700;color:#3B2516;font-family:'Segoe UI',Roboto,Arial,sans-serif;">Reset Your Password</p>
            <p style="margin:0 0 24px;font-size:14px;color:#8B7355;line-height:1.6;font-family:'Segoe UI',Roboto,Arial,sans-serif;">
              Hi <strong style="color:#3B2516;">{{firstName}}</strong>, we received a password reset request for your {{brandName}} account.
              Use the button below within <strong>10 minutes</strong> to set a new password.
            </p>

            <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
              <tr>
                <td>
                  <a class="em-btn" href="{{resetUrl}}"
                     style="display:inline-block;background:#5C4033;color:#FFFFFF;padding:12px 36px;text-decoration:none;border-radius:8px;font-size:14px;font-weight:600;font-family:'Segoe UI',Roboto,Arial,sans-serif;">
                    Reset Password
                  </a>
                </td>
              </tr>
            </table>

            <p style="margin:0 0 8px;font-size:13px;color:#A89278;font-family:'Segoe UI',Roboto,Arial,sans-serif;">Or copy this link into your browser:</p>
            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="background:#FDFAF6;border:1px solid #E8DFD4;border-radius:8px;margin-bottom:24px;">
              <tr>
                <td style="padding:12px 16px;font-size:12px;color:#8B7355;word-break:break-all;font-family:'Segoe UI',Roboto,Arial,sans-serif;">
                  {{resetUrl}}
                </td>
              </tr>
            </table>

            <p style="margin:0;font-size:13px;color:#A89278;line-height:1.6;font-family:'Segoe UI',Roboto,Arial,sans-serif;">
              If you did not make this request, you can safely ignore this email. Your account remains secure.
            </p>
          </td>
        </tr>

        {{> footer}}

      </table>
    </td>
  </tr>
</table>
</body>
</html>
